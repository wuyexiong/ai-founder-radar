# ==========================================================
# IndieRadar 环境变量配置模板（复制为 .env.local 即可生效）
# 阶段 1 本地预览可全部留空，系统会自动降级读取本地精选样本数据！
# ==========================================================

# 1. Supabase PostgreSQL 数据库连接串（阶段 2 填入）
# 获取路径：Supabase 控制台 -> Connect -> Transaction Pooler / Session Pooler URI
DATABASE_URL=""

# 2. AI 商业提炼模型密钥（阶段 2 二选一填入即可）
# 方案 A：Google AI Studio 免费密钥（https://aistudio.google.com/apikey）
GEMINI_API_KEY=""
GEMINI_MODEL=""

# 方案 B：兼容 OpenAI 格式的国内/第三方平台（如 DeepSeek 或 硅基流动 SiliconFlow）
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-chat"

# 方案 C：本机 Rapid-MLX 本地模型服务（自动探测 8080~8083 / 8000 端口 OpenAI 兼容端点）
# 本地启动 rapid-mlx serve 后，radar:sync 会自动探测并优先调用，无需填此项
RAPID_MLX_URL=""
RAPID_MLX_MODEL=""

# 方案 D：本地 Ollama 备选
OLLAMA_MODEL=""
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"

# 3. 可选数据源凭据：Reddit Script OAuth（留空默认走免认证 Arctic Shift 实时镜像）
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# 4. 站点公网根域名（用于生成多语言 SEO canonical / hreflang / sitemap.xml）
NEXT_PUBLIC_SITE_URL="https://indieradar.dev"

# 5. 访问统计埋点（阶段 3 上线时按需选填）
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_CLARITY_ID=""
