# ==========================================================
# IndieRadar 环境变量配置模板（复制为 .env.local 即可生效）
# 阶段 1 本地预览可全部留空，系统会自动降级读取本地精选样本数据！
# ==========================================================

# 1. Supabase PostgreSQL 数据库连接串（阶段 2 填入）
# 获取路径：Supabase 控制台 -> Connect -> Transaction Pooler / Session Pooler URI
DATABASE_URL=""

# 2. AI 商业提炼模型密钥（阶段 2 二选一填入即可）
# 方案 A：Google AI Studio 免费密钥（https://aistudio.google.com/apikey）
GEMINI_API_KEY=""

# 方案 B：兼容 OpenAI 格式的国内/第三方平台（如 DeepSeek 或 硅基流动 SiliconFlow）
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-chat"

# 3. 访问统计埋点（阶段 3 上线时按需选填）
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_CLARITY_ID=""
