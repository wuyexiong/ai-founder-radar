# ==========================================================
# AI Founder Radar 环境变量配置模板（复制为 .env.local 即可生效）
# 阶段 1 本地预览可全部留空，系统会自动降级读取本地精选样本数据！
# ==========================================================

# 1. Supabase PostgreSQL 数据库连接串（阶段 2 填入）
# 获取路径：Supabase 控制台 -> Connect -> Transaction Pooler / Session Pooler URI
DATABASE_URL=""

# 2. AI 商业提炼模型密钥（阶段 2 二选一填入即可）
# 方案 A：Google AI Studio 免费密钥（https://aistudio.google.com/apikey）
GEMINI_API_KEY=""
GEMINI_MODEL=""

# 方案 B：兼容 OpenAI 格式的国内/第三方平台（如 DeepSeek 或 硅基流动 SiliconFlow）
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-chat"

# 方案 C：本机 Rapid-MLX 本地模型服务（自动探测 8080~8083 / 8000 端口 OpenAI 兼容端点）
# 本地启动 rapid-mlx serve 后，radar:sync 会自动探测并优先调用，无需填此项
RAPID_MLX_URL=""
RAPID_MLX_MODEL=""

# 方案 D：本地 Ollama 备选
OLLAMA_MODEL=""
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"

# 3. 可选数据源凭据：Reddit Script OAuth（留空默认走免认证 Arctic Shift 实时镜像）与 Jina Reader Key
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
JINA_API_KEY=""

# 4. 站点公网根域名、Search Console 校验、按需缓存刷新与异构巡检自愈密钥
NEXT_PUBLIC_SITE_URL="https://radar.aibuildon.com"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
REVALIDATE_SECRET=""
# Vercel Cron 自动携带 Bearer CRON_SECRET 访问 /api/cron/watchdog；填入仅含 Actions: Read & write 权限的 Fine-grained PAT 后，若 GitHub 定时丢包将自动跨云补跑
CRON_SECRET=""
GITHUB_DISPATCH_TOKEN=""
GITHUB_REPOSITORY="wuyexiong/ai-founder-radar"

# 5. 每日早报邮件发送服务（可选，填入 Resend API Key 后自动发送欢迎信与每日 8 点早报）
RESEND_API_KEY=""
RESEND_FROM_EMAIL="AI Founder Radar <digest@radar.aibuildon.com>"

# 6. 访问统计埋点（阶段 3 上线时按需选填）
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_CLARITY_ID=""
