{
  "name": "ai-founder-radar",
  "version": "0.1.0",
  "private": true,
  "description": "AI Founder Radar — 每日 10 分钟全球 AI 创业、新品与真实变现雷达 (Next.js + Tailwind + Drizzle + Supabase)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "radar:sync": "node --import tsx --use-env-proxy scripts/sync-radar.ts",
    "radar:backfill": "node --import tsx --use-env-proxy scripts/sync-radar.ts --backfill-only",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.41.0",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "opencc-js": "^1.4.2",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
